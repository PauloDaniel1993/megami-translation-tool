{"page_id": "map036:page:00067-00069", "page_index": 13, "file": "map036.adx", "scene_id": "map036:scene:0001", "scene_title_jp": "__file_start__", "start_line": 67, "end_line": 69, "script_range_start": 67, "script_range_end": 70, "terminator": "@h", "speaker_present": false, "speaker_jp": null, "speaker_en": null, "page_role": "narration", "textbox": {"max_lines_total": 4, "max_chars_per_line": 50, "speaker_present": false, "dialogue_lines_available": 4, "dialogue_prefix": "   "}, "entries": [{"line_id": "map036:00067", "file": "map036.adx", "line_number": 67, "source_line": "盗賊達の屯する室内に殺気が膨れ上がり、目の前の盗賊が", "source_hash": "37de0a01ef6e5e075a38478a3a3b88cb1544430c", "jp": "盗賊達の屯する室内に殺気が膨れ上がり、目の前の盗賊が", "en": "", "role": "narration", "kind": "text", "speaker_jp": null, "speaker_en": null, "render_prefix": "", "translatable": true, "auto": false, "status": "pending", "max_chars": 50}, {"line_id": "map036:00068", "file": "map036.adx", "line_number": 68, "source_line": "ショートソードに手を掛けるよりも早く剣を抜き放った俺は", "source_hash": "6d872164472b0164946bb2d8a4570dea1f72c8fd", "jp": "ショートソードに手を掛けるよりも早く剣を抜き放った俺は", "en": "", "role": "narration", "kind": "text", "speaker_jp": null, "speaker_en": null, "render_prefix": "", "translatable": true, "auto": false, "status": "pending", "max_chars": 50}, {"line_id": "map036:00069", "file": "map036.adx", "line_number": 69, "source_line": "そのまま其の盗賊を切り倒して盗賊達の直中に躍り込んだ", "source_hash": "f2a3c2435fdf3ec528ff8efb7256f69a75559f9f", "jp": "そのまま其の盗賊を切り倒して盗賊達の直中に躍り込んだ", "en": "", "role": "narration", "kind": "text", "speaker_jp": null, "speaker_en": null, "render_prefix": "", "translatable": true, "auto": false, "status": "pending", "max_chars": 50}]}
